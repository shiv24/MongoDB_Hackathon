# MongoDB Atlas hackathon sandbox (from the invite email)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_DB=promptforge

# Voyage AI: embeddings + reranking (keep EMBED_DIMS in sync with the vector indexes)
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5
EMBED_DIMS=1024
RERANK_MODEL=rerank-2.5

# ElevenLabs Agents: the conversational agent (the only LLM in the stack, on ElevenLabs credits)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=              # printed by scripts/setup_elevenlabs_agent.py
ELEVENLABS_AGENT_LLM=claude-sonnet-5-5
ELEVENLABS_VOICE_ID=              # optional
PUBLIC_BASE_URL=                  # https tunnel to this app, e.g. from `cloudflared tunnel --url http://localhost:8000`
AGENT_TOOL_SECRET=                # random string; sent as a header on every agent tool call

# LangSmith (LangChain) tracing of retrieval and each agent tool step
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=promptforge

# Session cookie signing
SESSION_SECRET=change-me
