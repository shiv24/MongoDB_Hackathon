# MongoDB Atlas hackathon sandbox (from the invite email)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_DB=promptforge

# Claude: intent resolution, brief assembly, execution, lesson proposals
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Voyage AI embeddings (voyage-3 returns 1024 dims; keep in sync with the vector index)
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3
EMBED_DIMS=1024

# ElevenLabs Speech-to-Text: voice brief (server-side only, never sent to the browser)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# Session cookie signing
SESSION_SECRET=change-me
